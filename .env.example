# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://localhost/dependiq

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Security
SECRET_KEY=change-this-to-a-secure-random-string
SESSION_SECRET=change-this-to-a-secure-random-string
SECURE_COOKIES=false

# GitHub OAuth Configuration (Optional - run 'make github' to set up)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Application Environment
ENVIRONMENT=development

# Email Service Configuration (Optional)
# Option 1: Gmail SMTP (recommended for testing - free)
EMAIL_SERVICE=gmail
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=DependIQ

# Option 2: SendGrid (paid service)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com

# Selenium Test Configuration (Optional)
TEST_BASE_URL=http://localhost:8000
HEADLESS=false

# Test Email Service (for automated testing)
# Option 1: mail.tm (FREE - no API key needed!)
USE_MAILTM=true

# Option 2: Mailosaur (paid service with free trial)
# MAILOSAUR_API_KEY=your-mailosaur-api-key
# MAILOSAUR_SERVER_ID=your-server-id
# TEST_EMAIL_DOMAIN=@xyz123.mailosaur.net

# Option 3: Mailtrap (paid service with free tier)
# MAILTRAP_API_TOKEN=your-mailtrap-api-token
# MAILTRAP_INBOX_ID=your-inbox-id
# TEST_EMAIL_DOMAIN=@inbox.mailtrap.io

# GitHub Test Credentials (for OAuth testing)
TEST_GITHUB_USERNAME=your-test-github-username
TEST_GITHUB_PASSWORD=your-test-github-password
