# WorkOS AuthKit Configuration (required)
WORKOS_API_KEY=sk_test_your_key_here
WORKOS_CLIENT_ID=client_your_id_here
WORKOS_REDIRECT_URI=http://localhost:8000/api/auth/callback
WORKOS_COOKIE_PASSWORD=generate-with-python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())

# Database Configuration
DATABASE_URL=postgresql+asyncpg://localhost/dependiq

# Application Environment
ENVIRONMENT=development

# Application URL
APP_URL=http://localhost:8000

# Session Security
SECRET_KEY=change-this-to-a-secure-random-string

# OpenAI API Configuration (for dependency analysis)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration (optional, alternative to OpenAI)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email Service Configuration (Optional)
EMAIL_SERVICE=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
